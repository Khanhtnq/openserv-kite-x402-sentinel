# ============================================================================
# Kite-x402 + OpenServ Reasoning Autonomous DeFi Firewall & Payment Sentinel
# ============================================================================

# Canonical EVM wallet receiving paid x402 v2 sentinel API settlements
PAY_TO=0xcbEDbeCC127a32217075Ff40f16Ec804aa1E0533

# Kite Chain environment: "mainnet" (eip155:2366 USDC.e, 6 dec) or "testnet" (eip155:2368 pieUSD, 18 dec)
KITE_NETWORK=mainnet

# Price in USD per paid /v1/sentinel/* API call
PRICE_USD=0.001

# Kite Pieverse x402 v2 facilitator (keep /v2 suffix: SDK/gateway appends /supported, /verify, /settle)
FACILITATOR_URL=https://facilitator.pieverse.io/v2

# Secondary Base Mainnet x402 v2 facilitator
BASE_FACILITATOR_URL=https://facilitator.payai.network

# OpenServ SERV Reasoning API (https://console.openserv.ai)
# Remember to enable "Collection is on" at https://console.openserv.ai/settings/organization
SERV_API_KEY=
SERV_BASE_URL=https://inference-api.openserv.ai/v1
SERV_MODEL=gpt-5.4-mini-serv-multipath

# OpenServ Agent SDK (@openserv-labs/sdk v2.4.1) credentials (optional for standalone HTTP/demo mode)
OPENSERV_API_KEY=
OPENSERV_AUTH_TOKEN=
DISABLE_TUNNEL=true

# RPC Endpoints for live eth_call & eth_chainId preflight simulation
KITE_MAINNET_RPC_URL=https://rpc.gokite.ai
KITE_TESTNET_RPC_URL=https://rpc-testnet.gokite.ai
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# HTTP Server Port
PORT=8080
